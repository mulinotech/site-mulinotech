DirectoryIndex index.html

RewriteEngine On

# 1. Redireciona requisições diretas com .html para a versão sem extensão
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Redireciona /index (sem extensão) ou /index.html para a raiz /
RewriteRule ^index$ / [R=301,L]

# 3. Reescreve internamente a URL sem extensão adicionando .html para o servidor processar
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)$ $1.html [L]
